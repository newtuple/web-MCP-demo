# AWS SES settings
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
SES_FROM_EMAIL=

# Lead inbox routing
CONTACT_LEADS_EMAIL=
CAREERS_LEADS_EMAIL=

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=20

# Optional existing chat endpoint config
LITELLM_BASE_URL=
LITELLM_MODEL=
LITELLM_API_KEY=

# Cloudflare Turnstile (bot protection)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Google Analytics 4
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# LinkedIn Insight Tag
NEXT_PUBLIC_LINKEDIN_PARTNER_ID=XXXXXXX

# Meta (Facebook/Instagram) Pixel
NEXT_PUBLIC_META_PIXEL_ID=XXXXXXXXXXXXXXX

# Generated demo pages (/api/demo-app -> functions/api/demo-app.ts)
# The model writes a whole page per request; see docs/webmcp-demo-apps.md.
OPENAI_API_KEY=
# Model that writes the page. Defaults to gpt-5.4-mini (~25s for a full page).
# OPENAI_MODEL is deliberately not used by this endpoint.
DEMO_APP_MODEL=gpt-5.4-mini
# low | medium | high  ('minimal' is rejected by these models)
DEMO_APP_REASONING_EFFORT=low
DEMO_APP_RATE_LIMIT=6
DEMO_APP_TIMEOUT_MS=150000
